---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Zigang Zhu</div>
    <div class="text-3xl py-3 font-bold">Product Manager</div>
    <div class="py-2">
      <text class="text-lg">
        Master's student in Information Management & Business Analytics at <b>The Chinese University of Hong Kong, Shenzhen</b>.
        Passionate about fintech product design, user experience optimization, and AI-driven product innovation.
        Previously interned at <b>Tiger Brokers</b> and <b>Hupu</b>, with hands-on experience in derivatives trading UX, 0-to-1 feature design, and data-driven user growth.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:zigangzhu@foxmail.com" target="_blank"> Let's connect!</a>
      <a href="/cv" class="btn btn-outline ml-5">
        View my CV
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="Khrushchev Simulator — AI-Driven Historical Strategy SLG"
    img="/post_img.webp"
    desc="An indie AI-powered strategy game featuring emergent narrative through LLM-driven dialogue. Players navigate 5 factions and 31 characters via natural language diplomacy, with a core loop of intelligence generation, intent parsing, and world state emergence."
    url="https://sim.zhuzigang.com"
    badge="AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Hupu Off-Site Content Distribution Platform"
    img="/post_img.webp"
    desc="Designed an automated content distribution system that achieved 10,000 new users per week during trial run. Built end-to-end pipeline from task publishing to data monitoring with AI-powered content production."
    url="/projects"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Tiger Brokers — Order Search UX Redesign"
    img="/post_img.webp"
    desc="Redesigned the order history search experience for derivatives trading. Introduced fuzzy search and underlying asset association, boosting daily PV from 24K to 28K with zero related customer complaints."
    url="/projects"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
